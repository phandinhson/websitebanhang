APP_NAME="Website Bán Hàng"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Cấu hình kết nối MongoDB
# ============================================================
DB_CONNECTION=mongodb
MONGO_URI=mongodb://localhost:27017/websitebanhang
MONGO_DB=websitebanhang

# Nếu MongoDB yêu cầu xác thực:
# MONGO_URI=mongodb://username:password@localhost:27017/websitebanhang
# MONGO_USERNAME=
# MONGO_PASSWORD=

# ============================================================
# Cấu hình JWT Authentication
# ============================================================
JWT_SECRET=
JWT_ALGO=HS256
# Thời gian hết hạn token (phút) - mặc định 60 phút
JWT_TTL=60
# Thời gian hết hạn refresh token (phút) - mặc định 2 tuần
JWT_REFRESH_TTL=20160
# Thời gian leeway (giây)
JWT_LEEWAY=0
# Đặt thành true để gửi token qua cookie
JWT_COOKIE=false

# ============================================================
# Cấu hình Ứng dụng
# ============================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ============================================================
# Cấu hình Mail (tuỳ chọn - dùng cho xác nhận email, đặt hàng)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@websitebanhang.vn"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Cấu hình AWS S3 (tuỳ chọn - lưu trữ ảnh sản phẩm)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# Cấu hình CORS - URL frontend được phép truy cập API
# ============================================================
FRONTEND_URL=http://localhost:3000

# ============================================================
# Cấu hình Phân trang
# ============================================================
PAGINATION_PER_PAGE=12
